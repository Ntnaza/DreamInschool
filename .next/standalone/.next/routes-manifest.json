  "dynamicRoutes": [
    {
      "page": "/berita/[id]",
      "regex": "^/berita/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/berita/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
