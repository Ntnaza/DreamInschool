// --------------------------------------------------------
// KONFIGURASI KONEKSI
// --------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------
// 0. MANAJEMEN ANGKATAN / PERIODE (Arsip Masa Lalu)
// --------------------------------------------------------

model Periode {
  id          Int      @id @default(autoincrement())
  tahun       String   @unique // Contoh: "2024/2025"
  namaKabinet String?  // Contoh: "Jiva Abisatya"
  logoKabinet String?  @db.LongText
  fotoAngkatan String? @db.LongText // Foto pelantikan / foto bareng
  isAktif     Boolean  @default(false)
  
  // Relasi ke data yang diarsipkan
  pengurus    Pengurus[]
  leaders     Leader[]
  proker      ProgramKerja[]
  berita      Berita[]
  surat       Surat[]
  keuangan    Keuangan[]
  galeri      Galeri[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// --------------------------------------------------------
// 1. DATA PENGURUS & SISTEM LOGIN (Auth & User Management)
// --------------------------------------------------------

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  role      Role     @default(PENGURUS)

  pengurus   Pengurus? @relation(fields: [pengurusId], references: [id])
  pengurusId Int?      @unique

  berita     Berita[]  // relasi 1 User → banyak Berita

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// Tabel Data Diri Anggota OSIS/MPK
model Pengurus {
  id        Int      @id @default(autoincrement())
  nama      String
  nis       String   @unique
  kelas     String   
  jabatan   String   
  divisi    String
  fotoUrl   String? @db.LongText
  visi      String?  @db.Text
  misi      String?  @db.Text
  hp        String?
  status    StatusPengurus @default(AKTIF)
  isAdvisor Boolean  @default(false)

  // Arsir: Link ke Periode
  periodeId Int?     
  periode   Periode? @relation(fields: [periodeId], references: [id])

  // Media Sosial & Kontak
  email        String?
  instagram    String?
  tiktok       String?
  domisili     String?   
  transportasi String?   
  motto        String?   
  tglLahir     DateTime? 
  idCardDesign String?   @db.LongText

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User?
  absensi   Absensi[]
  programKerja ProgramKerja[]
}

// --------------------------------------------------------
// 2. MODUL INBOX ASPIRASI (Pesan Siswa)
// --------------------------------------------------------
model Aspirasi {
  id        Int      @id @default(autoincrement())
  pengirim  String   @default("Anonim")
  kelas     String?
  isi       String   @db.Text
  kategori  String
  status    StatusAspirasi @default(PENDING)
  
  balasan   String?  @db.Text 
  balasanAt DateTime?         

  createdAt DateTime @default(now())
}

// --------------------------------------------------------
// 3. MODUL KELOLA BERITA (CMS Artikel)
// --------------------------------------------------------
model Berita {
  id        Int      @id @default(autoincrement())
  judul     String
  slug      String   @unique

  konten    String   @db.LongText
  gambar    String?  @db.LongText
  kategori  String

  penulis   User     @relation(fields: [penulisId], references: [id])
  penulisId Int

  // Arsir: Link ke Periode
  periodeId Int?     
  periode   Periode? @relation(fields: [periodeId], references: [id])

  views     Int      @default(0)
  status    String   @default("PUBLISHED")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --------------------------------------------------------
// 4. MODUL PROGRAM KERJA (Kanban Board)
// --------------------------------------------------------

model ProgramKerja {
  id           Int      @id @default(autoincrement())
  nama         String
  deskripsi    String?  @db.Text
  divisi       String
  
  // Arsir: Link ke Periode
  periodeId Int?     
  periode   Periode? @relation(fields: [periodeId], references: [id])

  status       StatusProker @default(TODO)
  progress     Int          @default(0)        
  prioritas    String       @default("Medium") 
  anggaran     Float        @default(0)        
  
  deadline     DateTime?    
  startDate    DateTime?    

  image        String?   @db.LongText
  isFeatured   Boolean      @default(false)
  lokasi       String?      @default("Lingkungan Sekolah") 

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pj           Pengurus? @relation(fields: [pjId], references: [id])
  pjId         Int?

  anggaranTerpakai Float @default(0) 
  transaksi    Keuangan[] 
}

// --------------------------------------------------------
// 5. MODUL SCAN ABSENSI (Log Kehadiran)
// --------------------------------------------------------

model Acara {
  id                Int      @id @default(autoincrement())
  nama              String
  deskripsi         String?  @db.Text
  tipe              TipeAcara @default(SEKALI_PAKAI)
  hari              String?  
  tanggal           DateTime @default(now())
  waktuMulai        DateTime? 
  waktuSelesai      DateTime?
  waktuMulaiAktual  DateTime? 
  waktuSelesaiAktual DateTime? 
  lokasi            String?  @default("Sekolah")
  status            StatusAcara @default(UPCOMING)
  autoStart         Boolean  @default(false)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  absensi           Absensi[]
  sesi              SesiAcara[]
}

model SesiAcara {
  id                Int      @id @default(autoincrement())
  acaraId           Int
  acara             Acara    @relation(fields: [acaraId], references: [id], onDelete: Cascade)
  waktuMulai        DateTime @default(now())
  waktuSelesai      DateTime?
  status            StatusAcara @default(ONGOING)
  
  absensi           Absensi[]
  createdAt         DateTime @default(now())
}

model Absensi {
  id          Int      @id @default(autoincrement())
  tanggal     DateTime @default(now())
  
  acara       Acara    @relation(fields: [acaraId], references: [id], onDelete: Cascade)
  acaraId     Int

  sesi        SesiAcara? @relation(fields: [sesiId], references: [id], onDelete: SetNull)
  sesiId      Int?

  kegiatan    String   
  
  status      StatusKehadiran @default(HADIR)
  keterangan  String?

  pengurus    Pengurus @relation(fields: [pengurusId], references: [id])
  pengurusId  Int
}

// --------------------------------------------------------
// 6. MODUL SURAT MENYURAT (Arsip Surat)
// --------------------------------------------------------
model Surat {
  id          Int      @id @default(autoincrement())
  nomorSurat  String   @unique
  jenis       String   
  perihal     String
  tujuan      String
  fileUrl     String?  
  tanggal     DateTime @default(now())

  // Arsir: Link ke Periode
  periodeId Int?     
  periode   Periode? @relation(fields: [periodeId], references: [id])
}

// --------------------------------------------------------
// 7. MODUL KAS & ANGGARAN (Keuangan)
// --------------------------------------------------------
model BukuKas {
  id          Int         @id @default(autoincrement())
  nama        String      @unique
  deskripsi   String?     @db.Text
  icon        String?     @default("Wallet")
  color       String?     @default("blue")
  
  transaksi   Keuangan[]
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Keuangan {
  id          Int      @id @default(autoincrement())
  judul       String
  tipe        TipeTransaksi 
  nominal     Float
  kategori    String   
  tanggal     DateTime @default(now())
  buktiUrl    String?
  
  fotoBarang  String?     @db.LongText
  fotoNota    String?     @db.LongText

  kuantitas   Float?      @default(1)
  satuan      String?     @default("pcs")

  keterangan  String?  @db.Text
  
  periodeId Int?     
  periode   Periode? @relation(fields: [periodeId], references: [id])

  bukuKas     BukuKas?     @relation(fields: [bukuKasId], references: [id], onDelete: Cascade)
  bukuKasId   Int?

  proker      ProgramKerja? @relation(fields: [prokerId], references: [id])
  prokerId    Int?
}

// --------------------------------------------------------
// 8. MODUL INVENTARIS (Aset Barang)
// --------------------------------------------------------
model Inventaris {
  id          Int          @id @default(autoincrement())
  nama        String
  kode        String       @unique 
  kategori    String       
  kondisi     String       
  harga       Float        @default(0)
  fotoUrl     String?      @db.LongText
  serialNum   String?      
  
  status      StatusBarang @default(AVAILABLE)
  peminjam    String?      
  tglPinjam   DateTime?    
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  riwayat     RiwayatAset[]
}

model RiwayatAset {
  id            Int      @id @default(autoincrement())
  peminjam      String
  tglKeluar     DateTime
  tglKembali    DateTime @default(now())
  kondisiKembali String  
  
  inventaris    Inventaris @relation(fields: [inventarisId], references: [id], onDelete: Cascade)
  inventarisId  Int
}

model WebsiteConfig {
  id              Int      @id @default(1)
  namaOrganisasi  String   @default("OSIS MPK")
  deskripsi       String?  @db.Text
  logoUrl         String?  @db.LongText
  faviconUrl      String?  @db.LongText
  
  instagram       String?  @default("https://instagram.com/")
  youtube         String?  @default("https://youtube.com/")
  tiktok          String?  @default("https://tiktok.com/")
  
  email           String?  @default("admin@school.sch.id")
  telepon         String?  @default("0263123456")
  alamat          String?  @db.Text
  mapUrl          String?  @db.Text 
  
  updatedAt       DateTime @updatedAt
}

model AppConfig {
  id              Int     @id @default(autoincrement())
  idCardBackImage String? @db.LongText 
}

// --------------------------------------------------------
// ENUMS
// --------------------------------------------------------

enum Role {
  ADMIN     
  PENGURUS  
}

enum StatusPengurus {
  AKTIF
  NONAKTIF
  ALUMNI
}

enum StatusAspirasi {
  PENDING
  DITERIMA
  DITOLAK
  SELESAI
}

enum StatusProker {
  TODO
  IN_PROGRESS
  DONE
  BATAL
}

enum TipeAcara {
  SEKALI_PAKAI
  RUTINAN
}

enum StatusAcara {
  UPCOMING    
  ONGOING     
  COMPLETED   
  CANCELLED   
}

enum StatusKehadiran {
  HADIR
  IZIN
  SAKIT
  ALPA
}

enum TipeTransaksi {
  PEMASUKAN
  PENGELUARAN
}

enum KondisiBarang {
  BAIK
  RUSAK_RINGAN
  RUSAK_BERAT
  HILANG
}

enum StatusBarang {
  AVAILABLE
  BORROWED
  MAINTENANCE
  LOST
}

// --------------------------------------------------------
// 10. MODUL GALERI KEGIATAN
// --------------------------------------------------------

model Galeri {
  id        Int      @id @default(autoincrement())
  judul     String
  kategori  String
  tanggal   DateTime @default(now())
  
  periodeId Int?     
  periode   Periode? @relation(fields: [periodeId], references: [id])

  images    String   @db.LongText 
  
  deskripsi String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Leader {
  id      Int     @id @default(autoincrement())
  name    String
  role    String
  image   String  @db.LongText
  vision  String  @db.Text
  mission String  @db.Text
  tags    String? 
  
  periodeId Int?     
  periode   Periode? @relation(fields: [periodeId], references: [id])
}

model Visitor {
  id        Int      @id @default(autoincrement())
  ip        String
  userAgent String?
  path      String   @default("/")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([ip, path, createdAt]) 
}

// --------------------------------------------------------
// 11. MANAJEMEN DIVISI (Dinamis)
// --------------------------------------------------------
model Divisi {
  id        Int      @id @default(autoincrement())
  nama      String   @unique
  deskripsi String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jabatans  Jabatan[] 
}

model Jabatan {
  id        Int      @id @default(autoincrement())
  nama      String
  aksesLevel AksesLevel @default(UMUM)
  divisiId  Int
  divisi    Divisi   @relation(fields: [divisiId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([nama, divisiId]) 
}

enum AksesLevel {
  PIMPINAN
  SEKRETARIS
  BENDAHARA
  DIVISI
  PENGAWAS
  UMUM
}

model KategoriGaleri {
  id        Int      @id @default(autoincrement())
  nama      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HelpVideo {
  id        Int      @id @default(autoincrement())
  title     String
  youtubeId String   @unique
  duration  String?
  desc      String?  @db.Text
  thumbnail String?  @db.LongText
  createdAt DateTime @default(now())
}

model HelpTicket {
  id          Int      @id @default(autoincrement())
  subject     String
  description String   @db.Text
  fotoBukti   String?  @db.LongText
  status      StatusTicket @default(OPEN)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum StatusTicket {
  OPEN      
  ON_REVIEW 
  FIXED     
  CLOSED    
}
